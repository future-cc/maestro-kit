# maestro-kit 自测专用配置：被测对象是模拟器自带的“设置”应用，不依赖任何业务项目。
APP_ID="com.android.settings"
BUILD_CMD=""
APK_PATH=""
FLOW_GLOBS="_selftest/*.yaml"
FLOW_TIMEOUT=120
NOTIFY=0
ENV_FILE=".maestro/e2e.env"
BLOCK_PATTERNS=""
LINT_CLEARSTATE_BLOCK="login"
# 运行期间临时切到 Gboard（结束后自动恢复）；设备上没有它时只会警告并沿用当前输入法
PREP_IME="com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME"
