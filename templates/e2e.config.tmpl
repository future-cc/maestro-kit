# maestro-kit 项目配置（KEY=VALUE，shell 语法）。由 install.sh 生成，按项目修改。
# 项目类型: @TYPE@

# 被测 App 的包名（用于运行前检查是否已安装）
APP_ID="@APP_ID@"

# 构建并安装（bash .maestro/kit/e2e.sh --build 时使用）
BUILD_CMD="@BUILD_CMD@"
APK_PATH="@APK_PATH@"

# 要跑的 flow（相对 .maestro/，空格分隔的通配符）。subflows/ 与 kit/ 自动排除
FLOW_GLOBS="*/*.yaml"

# 每个 flow 的超时秒数（可被环境变量 E2E_TIMEOUT 覆盖）
FLOW_TIMEOUT=900

# 结束时是否弹 macOS 通知（1/0）
NOTIFY=1

# 账号等敏感变量放这个文件（KEY=VALUE，已加入 .gitignore），自动作为 -e 传给 maestro
ENV_FILE=".maestro/e2e.env"

# 失败归类里“被验证/风控拦截”的识别规则：用 | 分隔的正则，匹配错误信息和日志
BLOCK_PATTERNS=""

# lint：路径里包含这些关键字的 flow 不允许 launchApp clearState: true（逗号分隔，如 login）
LINT_CLEARSTATE_BLOCK="login"

# lint：点击的文字（text/id，不含 label）里含这些词的 flow 报 W013（逗号分隔）。正式环境/只读测试建议填，如 存款,取款,转入,退出登录
# 位置点击（point）拦不住，仍要靠人看；确需点击的写 `# lint-ignore: W013`
LINT_TAP_BLOCK=""

# 每个 flow 运行前执行的命令（shell 语法，可选）。个别手机上 Maestro 的 launchApp 不把 App 带到前台时，
# 可在这里用 adb 先冷启动 App（见 docs/REAL_DEVICE_NOTES.md R2）。ANDROID_SERIAL 已导出，adb 默认指向当前设备。例：
# PRE_FLOW_CMD="adb shell am force-stop com.example.app; adb shell am start -W -n com.example.app/.MainActivity"
# 用 am start -W（等启动完成再返回）代替固定 sleep：实测省约 4 秒/次；首屏是否出现由 flow 开头的 extendedWaitUntil 兜底
PRE_FLOW_CMD=""

# 运行期间临时切换到的输入法（"包名/服务类"，用 adb shell ime list -s 查看），结束后自动恢复。
# 设备默认是中文拼音输入法（搜狗等）时，英文输入会被转成汉字，建议填 Gboard：
# PREP_IME="com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME"
PREP_IME=""
